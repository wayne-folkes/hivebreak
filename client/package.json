{
  "name": "hivebreak-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "models": "blender -b --factory-startup --python ../art/blender/build.py",
    "icons": "blender -b --factory-startup --python ../art/blender/icons.py",
    "build:cli": "vite build --config vite.cli.config.ts",
    "cli": "vite build --config vite.cli.config.ts --logLevel warn && node dist-cli/hivebreak.mjs"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
